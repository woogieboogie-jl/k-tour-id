# K-Tour ID hackathon integration — values below are not credentials.
# Preferred isolated local preview: pnpm dev:harvey:local (no .env files required).
# Full-stack profile needs BOTH UI build opt-in and server runtime opt-in.
NEXT_PUBLIC_HK_ENABLED=1
HK_API_ENABLED=1
# Keep 1 for isolated tests. Set 0 only for a separately approved live testnet lane.
HK_ISOLATED_MOCK=1
# ── campaign ──
HK_CAMPAIGN_VENUE_ID=mois-0021cd596bc5b2a922ad
NEXT_PUBLIC_HK_CAMPAIGN_VENUE_ID=mois-0021cd596bc5b2a922ad
# 1 = floating "체험 혜택 여정 시작" button on the map + http://localhost:3000/hackathon deep link (dev/demo only; 0 for visual tests)
NEXT_PUBLIC_HK_DEMO_ENTRY=1
HK_CAMPAIGN_ID=hk-identity-perk-v1
HK_CAMPAIGN_ENDS_AT=2026-09-30T23:59:59+09:00
HK_DATA_DIR=.data/hackathon
# ── OmniOne CX (mock until the hackathon test account arrives; then HK_MODE_CX=cx) ──
HK_MODE_CX=mock
HK_CX_BASE_URL=https://cx.raonsecure.co.kr:18543
HK_CX_PROVIDER=comrc
HK_CX_ZKP_TYPE=AdultVerify
# ── OpenDID (mock = local signed sample; opendid currently fails closed until provider lifecycle is implemented) ──
HK_MODE_OPENDID=mock
HK_OPENDID_ISSUER_URL=http://localhost:8091
HK_OPENDID_VERIFIER_URL=http://localhost:8092
HK_OPENDID_TAS_URL=http://localhost:8090
HK_ISSUER_SIGNING_SEED=ondo-hackathon-issuer-seed-2026-09-14
# ── AI proposal (set GEMINI_API_KEY to use Gemini; otherwise rule-based) ──
# GEMINI_API_KEY=
HK_AI_PROMPT_VERSION=perk-proposal-v1
# ── Sui Testnet (deployed 2026-09-14) ──
HK_SUI_NETWORK=testnet
HK_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
HK_SUI_PACKAGE_ID=0xc5d26326ffd5267bb5b54625c1e2b9c03f7cca4753232d0b042c62ee74fd975d
HK_SUI_CAMPAIGN_ID=0xe3fce96c9c9e1086ff20dd7453e16ff2c52d3d3324e6e4e34446c7d0dc2ecf16
HK_SUI_CAMPAIGN_INITIAL_VERSION=349181955
HK_SUI_ISSUER_SECRET_KEY=
HK_SUI_AGENT_SECRET_KEY=
HK_SUI_SPONSOR_SECRET_KEY=
HK_SUI_EXPLORER=https://suiscan.xyz/testnet
# zkLogin (Google): create an OAuth Web client, add http://localhost:3000/hackathon/zklogin/callback as redirect URI
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# HK_ZKLOGIN_SALT_SEED=change-me-32-bytes-random
HK_ZKLOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1
# ── OmniOne Chain (stage) ──
HK_OMNIONE_RPC_URL=https://stage-chainapi.omnione.net/?token=<API_KEY>
HK_OMNIONE_CHAIN_ID=201210
HK_OMNIONE_PRIVATE_KEY=
HK_OMNIONE_REGISTRY_ADDRESS=0x696bc4e29c8f8079b6d3cd49d310a09577550e4c
HK_OMNIONE_GAS_LIMIT=300000
