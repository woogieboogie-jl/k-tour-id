# Documentation only. Never commit a populated .env or use production tokens.
# Existing CX-only/readonly profiles refuse this provider even if values exist.
SUMSUB_MODE=sandbox
NEXT_PUBLIC_ONDO_SUMSUB_SANDBOX=1
SUMSUB_APP_TOKEN=sbx:REPLACE_IN_SECRET_STORE
SUMSUB_SECRET_KEY=REPLACE_IN_SECRET_STORE
SUMSUB_SESSION_SECRET=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
SUMSUB_PREVIEW_ACCESS_CODE=REPLACE_WITH_RANDOM_16_OR_MORE_CHARACTERS
# Historical level; verify spelling in the existing Sandbox account.
SUMSUB_LEVEL_NAME=id-and-liveness
SUMSUB_ALLOWED_ORIGINS=https://EXACT-APPROVED-PREVIEW.vercel.app
# Distinct from the API secret. Configure matching SHA256 or SHA512 HEX webhook.
# Without a webhook secret, session/status polling can work; webhook refuses.
SUMSUB_WEBHOOK_SECRET=REPLACE_WITH_SEPARATE_RANDOM_WEBHOOK_SECRET
# Use ONE complete Upstash or KV pair, never both; do not share the CX key.
UPSTASH_REDIS_REST_URL=https://EXACT-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_IN_SECRET_STORE
SUMSUB_STORE_NAMESPACE=ktour:sumsub:sandbox:passport-preview
# Explicit test fixture only; forbidden on Vercel or NODE_ENV=production.
SUMSUB_LOCAL_MEMORY=0
