{
  "name": "ondo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "next build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "prepare:sites:ondo-b": "node scripts/ondo-b-standalone/prepare.mjs",
    "build:sites:ondo-b": "node scripts/ondo-b-standalone/build.mjs",
    "build:vercel:ondo-b": "pnpm prepare:sites:ondo-b && cd .ondo-b-standalone && ../node_modules/.bin/next build --webpack && cd .. && pnpm scan:vercel:ondo-b",
    "build:vercel:hackathon": "next build",
    "build:harvey:local": "node scripts/hackathon-local.mjs build",
    "start:harvey:local": "node scripts/hackathon-local.mjs start",
    "dev:harvey:local": "node scripts/hackathon-local.mjs dev",
    "test:harvey:unit": "node --import tsx --test tests/hackathon/*.test.ts",
    "test:harvey:outbox": "node --experimental-test-module-mocks --import tsx --test tests/hackathon-verification/omnione-*.test.ts",
    "test:harvey:e2e": "playwright test --config=playwright.harvey-integration.config.ts",
    "test:harvey:bff": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:3137 playwright test tests/e2e/ktour-harvey-bff-local.spec.ts tests/e2e/ktour-harvey-bff-recovery.spec.ts --project=mobile-chromium --workers=1 --output=artifacts/qa/harvey-bff-local",
    "scan:sites:ondo-b": "node scripts/ondo-b-standalone/scan-artifact.mjs",
    "scan:next:ondo-b": "node scripts/ondo-b-next-client-artifact.mjs",
    "scan:vercel:ondo-b": "ONDO_B_NEXT_SOURCE_ROOT=.ondo-b-standalone ONDO_B_NEXT_ROOT=.ondo-b-standalone/.next node scripts/ondo-b-next-client-artifact.mjs",
    "probe:sites:ondo-b": "node scripts/ondo-b-standalone/probe-http.mjs",
    "guard:deploy:ondo-b": "node scripts/ondo-b-standalone/assert-deploy-target.mjs",
    "dev": "next dev",
    "setup": "npx --yes pnpm@10.8.0 install --frozen-lockfile",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "next start",
    "test:contracts": "playwright test --config=playwright.contracts.config.ts",
    "test:contracts:fidelity": "playwright test tests/contracts/ondo-prd-fidelity.spec.ts --config=playwright.contracts.config.ts",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:core": "playwright test tests/e2e --grep @core --project=mobile-chromium",
    "test:e2e:a-regression": "playwright test tests/e2e/ondo-commerce-browser.spec.ts tests/e2e/ondo-connect-browser.spec.ts tests/e2e/ondo-profile.spec.ts --project=mobile-chromium --project=desktop-chromium --workers=1",
    "test:e2e:b": "pnpm test:e2e:b:core && pnpm test:e2e:b:regressions",
    "test:e2e:b:core": "playwright test tests/e2e/ondo-b-consumer-place-table.spec.ts tests/e2e/ondo-b-current-a11y-recovery.spec.ts tests/e2e/ondo-b-ja-critical-journey.spec.ts tests/e2e/ondo-b-my-korea-restoration.spec.ts tests/e2e/ondo-b-opendid-onboarding-restoration.spec.ts tests/e2e/ondo-b-profile-reputation-milestone.spec.ts tests/e2e/ondo-b-production-golden-fidelity.spec.ts tests/e2e/ondo-b-production-url-canonicalization.spec.ts --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-b-mobile-reflow.spec.ts --project=mobile-chromium --workers=1",
    "test:e2e:b:regressions": "playwright test tests/e2e/ondo-sleek-identity-labs.spec.ts --grep 'Japanese B Labs|B Labs isolates|B Labs remains usable|B Labs rejects incoherent stored bridge' --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-b-flow-coverage.spec.ts --grep 'FL-016|FL-018' --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-b-flow8-wallet-direction.spec.ts --grep 'FLOW8-(VIS-001|WALLET-002|RECOVERY-004|POLICY-005|COMPLETE-006|DURABLE-007|CANCEL-008|INDEPENDENCE-009|TRUTH-010|RETURN-011|FIRSTVIEW-013|VENUE-014)' --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-b-production-disclosure-focus.spec.ts --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-b-flow7-local-signal-direction.spec.ts --grep 'FLOW7-(VIS-001|MEDIA-002|POST-005|HISTORY-007|TRAVERSAL-009|CONSENT-012|VIS-013)' --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-b-production-clean1-regressions.spec.ts --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-sleek-r5r-layout-reflow.spec.ts --grep 'map and list controls reflow without collisions' --project=mobile-chromium --project=desktop-chromium --workers=1 && playwright test tests/e2e/ondo-sleek-focus-locale.spec.ts --grep 'long KO owned-surface copy wraps' --project=mobile-chromium --project=desktop-chromium --workers=1",
    "test:e2e:b:legacy": "playwright test tests/e2e/ondo-b-*.spec.ts tests/e2e/ondo-sleek-*.spec.ts --project=mobile-chromium --project=desktop-chromium --workers=1",
    "test:visual": "playwright test tests/visual --project=mobile-chromium",
    "test:visual:b": "pnpm test:visual:b:current && pnpm test:visual:b:production && pnpm test:visual:b:legacy",
    "test:visual:b:legacy": "playwright test tests/visual/ondo-b-flow-pixels-mobile.spec.ts --project=mobile-chromium --workers=1 && playwright test tests/visual/ondo-b-flow-pixels-desktop.spec.ts tests/visual/ondo-b-flow-pixels-responsive.spec.ts --project=desktop-chromium --workers=1",
    "test:visual:b:current": "playwright test --config=playwright.current-reference-visual.config.ts",
    "test:visual:b:production": "playwright test --config=playwright.production-visual.config.ts",
    "test:a11y": "playwright test tests/e2e --grep @a11y --project=mobile-chromium",
    "qa": "pnpm typecheck && pnpm build && pnpm test:contracts && pnpm test:e2e:core",
    "qa:b": "pnpm typecheck && pnpm exec next build --webpack && pnpm test:contracts && pnpm test:e2e:b && pnpm test:e2e:a-regression && pnpm test:visual:b && pnpm prepare:sites:ondo-b && pnpm build:sites:ondo-b && pnpm scan:sites:ondo-b && pnpm probe:sites:ondo-b && NEXT_PUBLIC_ONDO_QA_CONTROLS=0 pnpm exec next build --webpack && pnpm scan:next:ondo-b"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-serif-kr": "5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@mysten/sui": "2.31.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "ethers": "6.17.0",
    "geist": "^1.3.1",
    "input-otp": "1.4.1",
    "leaflet": "1.9.4",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^5.7.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "qrcode-generator": "2.0.4",
    "react": "19.2.6",
    "react-day-picker": "9.8.0",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "postcss": "^8.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.23.12",
    "tw-animate-css": "1.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64"
      ]
    }
  }
}
